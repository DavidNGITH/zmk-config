/*
 * ============================================================================
 * SPLITKB AURORA CORNE
 * ============================================================================
 *
 * LAYERS
 *
 *   0  QWERTY    Normal typing
 *   1  LOWER     Numbers / numpad / navigation
 *   2  RAISE     Media / editing / arrows
 *   3  ADJUST    RGB / keyboard controls
 *
 *
 * ============================================================================
 * DEFAULT / QWERTY
 * ============================================================================
 *
 *   ┌─────┬─────┬─────┬─────┬─────┬─────┐     ┌─────┬─────┬─────┬─────┬─────┬─────┐
 *   │ ESC │  Q  │  W  │  E  │  R  │  T  │     │  Y  │  U  │  I  │  O  │  P  │  Å  │
 *   ├─────┼─────┼─────┼─────┼─────┼─────┤     ├─────┼─────┼─────┼─────┼─────┼─────┤
 *   │ TAB │ A/⇧ │S/ALT│D/RSE│F/LWR│  G  │     │  H  │J/LWR│K/RSE│L/ALT│ Ö/⇧ │  Ä  │
 *   ├─────┼─────┼─────┼─────┼─────┼─────┤     ├─────┼─────┼─────┼─────┼─────┼─────┤
 *   │  <  │  Z  │  X  │  C  │  V  │  B  │     │  N  │  M  │  ,  │  .  │  -  │  "  │
 *   └─────┴─────┴─────┴─────┴─────┴─────┘     └─────┴─────┴─────┴─────┴─────┴─────┘
 *
 *   ┌─────────┬─────────┬─────────┐     ┌─────────┬─────────────┬─────────────┐
 *   │ GUI/DEL │   CTRL  │  SPACE  │     │ BACKSPC │ ENTER/LOWER │ CTRL/RAISE  │
 *   └─────────┴─────────┴─────────┘     └─────────┴─────────────┴─────────────┘
 *
 * ============================================================================
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";


        // ====================================================================
        // LAYER 0 - QWERTY
        // ====================================================================

        default_layer {
            bindings = <
                // Left hand                              // Right hand
                &kp ESC       &kp Q          &kp W          &kp E          &kp R          &kp T
                &kp Y         &kp U          &kp I          &kp O          &kp P          &kp ARNG

                &kp TAB       &mt LSHFT A    &mt LALT S     &lt 2 D        &lt 1 F        &kp G
                &kp H         &lt 1 J        &lt 2 K        &mt RALT L     &mt LSHFT ODIA  &kp ADIA

                &kp GRAVE     &kp Z          &kp X          &kp C          &kp V          &kp B
                &kp N         &kp M          &kp COMMA     &kp DOT        &kp MINUS      &kp SQT

                // Left thumbs
                &mt LGUI DEL  &kp LCTRL      &kp SPACE

                // Right thumbs
                &kp BSPC      &lt 1 RET      &lt 2 RCTRL
            >;
        };


        // ====================================================================
        // LAYER 1 - LOWER
        // ====================================================================
        //
        // LEFT SIDE
        //
        //   ┌─────┬─────┬─────┬─────┬─────┬─────┐
        //   │     │     │     │     │     │     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │ TAB │ ⇧   │ ALT │ RSE │ LWR │     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │TG(AD)│    │     │     │     │     │
        //   └─────┴─────┴─────┴─────┴─────┴─────┘
        //
        // The A/S/D/F positions expose the SPECIAL functions from QWERTY:
        //
        //   A → SHIFT
        //   S → ALT
        //   D → RAISE
        //   F → LOWER
        //
        // They no longer output A/S/D/F while LOWER is active.
        //
        //
        // RIGHT SIDE - NUMPAD
        //
        //   ┌─────┬─────┬─────┬─────┬─────┬─────┐
        //   │  7  │  8  │  9  │  +  │  /  │     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │  4  │  5  │  6  │  -  │ PGUP│     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │  1  │  2  │  3  │  *  │ PGDN│     │
        //   └─────┴─────┴─────┴─────┴─────┴─────┘
        //
        //   0 is on the rightmost thumb.
        //
        // Numbers are NORMAL number keys:
        //
        //   1 + SHIFT = !
        //   2 + SHIFT = @
        //   3 + SHIFT = #
        //   4 + SHIFT = $
        //   5 + SHIFT = %
        //   6 + SHIFT = ^
        //   7 + SHIFT = &
        //   8 + SHIFT = *
        //   9 + SHIFT = (
        //   0 + SHIFT = )
        //
        //
        // ADJUST TOGGLE
        //
        //   The ADJUST toggle is deliberately on LOWER.
        //
        //   Hold LOWER → press ADJ
        //
        //   This prevents accidentally entering ADJUST during normal typing.
        //
        // ====================================================================

        lower_layer {
            bindings = <
                // Left side - top row intentionally empty
                &trans        &trans        &trans        &trans        &trans        &trans

                // Special functions from the QWERTY home row
                &kp TAB       &kp LSHFT      &kp LALT       &mo 2         &mo 1         &trans

                // ADJUST toggle + remaining keys
                &tog 3        &trans         &trans        &trans        &trans        &trans


                // Right side - NUMPAD
                &kp N7        &kp N8        &kp N9        &kp PLUS       &kp FSLH       &trans
                &kp N4        &kp N5        &kp N6        &kp MINUS      &kp PG_UP      &trans
                &kp N1        &kp N2        &kp N3        &kp ASTRK      &kp PG_DN      &trans


                // EXACTLY the same thumb cluster as QWERTY
                &mt LGUI DEL  &kp LCTRL      &kp SPACE
                &kp BSPC      &lt 1 RET      &lt 2 RCTRL
            >;
        };


        // ====================================================================
        // LAYER 2 - RAISE
        // ====================================================================
        //
        // LEFT SIDE
        //
        //   ┌─────┬─────┬─────┬─────┬─────┬─────┐
        //   │PREV │NEXT │PLAY │ MUTE│ VOL-│ VOL+│
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │     │ UNDO│ CUT │     │ COPY│PASTE│
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │     │     │     │ F2  │ShF12│     │
        //   └─────┴─────┴─────┴─────┴─────┴─────┘
        //
        //
        // RIGHT SIDE - NORMAL ARROW CLUSTER
        //
        //   ┌─────┬─────┬─────┬─────┬─────┬─────┐
        //   │     │     │  ↑  │     │     │     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │     │     │     │     │     │     │
        //   ├─────┼─────┼─────┼─────┼─────┼─────┤
        //   │     │  ←  │  ↓  │  →  │     │     │
        //   └─────┴─────┴─────┴─────┴─────┴─────┘
        //
        // The arrow cluster is entirely on the 6-key right-hand section.
        // No thumb keys are used for arrows.
        //
        //
        // THUMBS
        //
        // Exactly the same as QWERTY.
        //
        // ====================================================================

        raise_layer {
            bindings = <
                // Left side - media
                &kp MPRV       &kp MNXT       &kp MPLY       &kp MUTE       &kp VOLD       &kp VOLU

                // Editing
                &trans        &kp LC(Z)      &kp LC(X)      &trans        &kp LC(C)      &kp LC(V)

                // Special
                &trans        &trans        &trans        &kp F2         &kp RSA(F12)   &trans


                // Right side - arrow cluster
                //
                //               ↑
                //             ← ↓ →
                //
                &trans        &trans        &trans         &trans        &trans        &trans
                &trans        &trans        &kp UP        &trans        &trans        &trans
                &trans        &kp LEFT       &kp DOWN       &kp RIGHT      &trans        &trans


                // EXACTLY the same thumbs as QWERTY
                &mt LGUI DEL  &kp LCTRL      &kp SPACE
                &kp BSPC      &lt 1 RET      &lt 2 RCTRL
            >;
        };


        // ====================================================================
        // LAYER 3 - ADJUST
        // ====================================================================
        //
        // Enter:
        //
        //   Hold LOWER → press ADJ
        //
        // Exit:
        //
        //   Hold LOWER → press ADJ again
        //
        //
        // RGB CONTROLS
        //
        //   SAT+    SAT-
        //   HUE+    HUE-
        //   VAL+    VAL-
        //
        //   RGB ON/OFF
        //   RGB MODE
        //   Brightness down
        //   Brightness up
        //
        // ====================================================================

        adjust_layer {
            bindings = <
                // Empty top row
                &trans        &trans        &trans        &trans        &trans        &trans

                // Saturation
                &kp UG_SATU    &kp UG_SATD    &trans        &trans        &trans        &trans

                // Hue / Value
                &kp UG_HUEU    &kp UG_HUED    &kp UG_VALU    &kp UG_VALD    &trans        &trans

                // RGB ON/OFF / MODE + brightness
                &kp UG_TOGG    &kp UG_NEXT    &trans        &tog 3         &kp BRID      &kp BRIU


                // Thumbs
                &trans        &trans        &trans
                &trans        &trans        &trans
            >;
        };
    };
};
